# Python environment and caches
.venv/
__pycache__/
*.pyc

# viewer local state
viewer/focus.json
viewer/.server.pid
viewer/.server.log

# generated output: only printed parts (files named by their ID, e.g. I5_print.3mf)
# and printed fit-test sets (test-*) are kept; everything else is rebuilt on demand
*/out/*
!*/out/[A-Z][0-9]*
!*/out/test-*
examples/out/

# build artifacts (but keep the user's original downloads)
*.zip
!*/original/*.zip

# private projects (not shared): remove a line to start tracking that project
changing-table/
bee-vac/

# inbox: uploads from the tracker page (private); keep the folder itself
inbox/*
!inbox/README.md
